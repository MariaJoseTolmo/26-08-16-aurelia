{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @aurelia/contracts build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "migration:run:prod": "node dist/database/run-migrations.js",
    "lint": "eslint src --ext .ts",
    "test": "ts-node src/test/api-smoke.ts",
    "test:smoke": "ts-node src/test/api-smoke.ts",
    "test:scope": "ts-node src/test/api-scope-smoke.ts",
    "test:roles": "ts-node src/test/api-functional-roles-smoke.ts",
    "test:legacy-import": "ts-node src/test/api-legacy-inspections-normalizer-smoke.ts && ts-node src/test/api-legacy-inspections-dry-run-smoke.ts && ts-node src/test/api-legacy-inspections-reporter-smoke.ts",
    "test:legacy-import:source": "ts-node src/test/api-legacy-inspections-source-smoke.ts",
    "test:mail": "ts-node src/test/api-messaging-template-smoke.ts && ts-node src/test/api-smtp-email-smoke.ts && ts-node src/test/api-mobile-sync-assignment-email-smoke.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "pnpm run typeorm migration:generate ./src/database/migrations/Migration -d ./src/database/data-source.ts",
    "migration:create": "pnpm run typeorm migration:create ./src/database/migrations/Migration",
    "migration:run": "pnpm run typeorm migration:run -d ./src/database/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert -d ./src/database/data-source.ts",
    "import:legacy-inspections": "ts-node src/cli/import-legacy-inspections.ts",
    "seed": "ts-node src/database/seeds/001-seed-phase1.ts && ts-node src/database/seeds/003-seed-finding-classifications.ts && ts-node src/database/seeds/009-seed-inspections-master-data.ts",
    "seed:bootstrap": "ts-node src/database/seeds/008-seed-bootstrap.ts",
    "seed:functional-roles": "ts-node src/database/seeds/007-seed-functional-roles.ts",
    "seed:inspections-master": "ts-node src/database/seeds/009-seed-inspections-master-data.ts",
    "seed:demo": "pnpm run seed && ts-node src/database/seeds/002-seed-demo-data.ts",
    "seed:all": "pnpm run seed:demo && ts-node src/database/seeds/005-seed-dev-password-reset.ts && ts-node src/database/seeds/006-seed-notifications-permissions.ts",
    "seed:finding-classifications": "ts-node src/database/seeds/003-seed-finding-classifications.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aurelia/contracts": "workspace:*",
    "@huggingface/transformers": "3.8.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
