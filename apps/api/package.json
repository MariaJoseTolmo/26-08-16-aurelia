{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @aurelia/contracts build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "migration:run:prod": "node dist/database/run-migrations.js",
    "lint": "eslint src --ext .ts",
    "test": "ts-node src/test/api-smoke.ts",
    "test:smoke": "ts-node src/test/api-smoke.ts",
    "test:scope": "ts-node src/test/api-scope-smoke.ts",
    "test:inspection-scope": "ts-node src/test/api-inspection-creation-scope-smoke.ts",
    "test:inspection-table-filters": "ts-node src/test/api-inspection-table-filters-smoke.ts",
    "test:inspection-sla-reassignment": "ts-node src/test/api-inspection-sla-reassignment-smoke.ts",
    "test:swagger": "ts-node src/test/api-swagger-inspections-smoke.ts && ts-node src/test/api-swagger-route-audit.ts",
    "test:swagger-routes": "ts-node src/test/api-swagger-route-audit.ts",
    "test:swagger-runtime": "ts-node src/test/api-swagger-runtime-smoke.ts",
    "test:auth-access": "ts-node src/test/api-inspector-web-login-smoke.ts",
    "test:legacy-projection": "ts-node src/test/api-legacy-inspections-table-projection-smoke.ts",
    "test:legacy-export": "ts-node src/test/api-legacy-inspection-periodic-report-smoke.ts",
    "test:waste": "ts-node src/test/api-waste-foundation-smoke.ts",
    "test:roles": "ts-node src/test/api-functional-roles-smoke.ts",
    "test:mail": "ts-node src/test/api-messaging-template-smoke.ts && ts-node src/test/api-inspection-rejection-email-template-smoke.ts && ts-node src/test/api-inspection-rejection-email-service-smoke.ts && ts-node src/test/api-smtp-config-smoke.ts && ts-node src/test/api-smtp-email-smoke.ts && ts-node src/test/api-mobile-sync-assignment-email-smoke.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "pnpm run typeorm migration:generate ./src/database/migrations/Migration -d ./src/database/data-source.ts",
    "migration:create": "pnpm run typeorm migration:create ./src/database/migrations/Migration",
    "migration:run": "pnpm run typeorm migration:run -d ./src/database/data-source.ts",
    "migration:revert": "pnpm run typeorm migration:revert -d ./src/database/data-source.ts",
    "seed": "ts-node src/database/seeds/001-seed-phase1.ts && ts-node src/database/seeds/002-seed-demo-data.ts && ts-node src/database/seeds/003-seed-finding-classifications.ts && ts-node src/database/seeds/004-seed-responsibles.ts",
    "seed:bootstrap": "ts-node src/database/seeds/008-seed-bootstrap.ts",
    "seed:functional-roles": "ts-node src/database/seeds/007-seed-functional-roles.ts",
    "seed:demo": "ts-node src/database/seeds/001-seed-phase1.ts && ts-node src/database/seeds/002-seed-demo-data.ts",
    "seed:all": "pnpm run seed && ts-node src/database/seeds/005-seed-dev-password-reset.ts && ts-node src/database/seeds/006-seed-notifications-permissions.ts",
    "seed:finding-classifications": "ts-node src/database/seeds/003-seed-finding-classifications.ts",
    "export:master-data-matrix": "ts-node src/cli/export-master-data-matrix.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aurelia/contracts": "workspace:*",
    "@azure/storage-blob": "^12.27.0",
    "@huggingface/transformers": "3.8.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
