# URL base de la API. Obligatoria: `shared/config/env.ts` lanza si falta.
# INCLUYE EL PREFIJO `/api`: la API declara `setGlobalPrefix('api')` en `main.ts`, y el
# front pide rutas relativas como `/auth/login`.
VITE_API_URL=http://localhost:3000/api

# Mock de desarrollo de las validaciones del flujo SIDREP de residuos.
#
# Solo el valor exacto `true` lo activa. Con el mock encendido, las dos
# validaciones del paso "Datos del traslado" responden con datos de muestra en vez
# de llamar a la API:
#
#   POST /waste/withdrawals/validate-transport   → aviso verde de patente verificada
#   POST /waste/withdrawals/weighing-ticket      → los tres pesos del ticket
#
# Existe porque esos dos endpoints todavía no están implementados y sin ellos el
# botón "Continuar" del paso 1 nunca se habilita, así que el paso 2 del flujo
# ("Documentos de respaldo") es inalcanzable y no se puede revisar.
#
# Para probar el estado de patente RECHAZADA, usá una patente que termine en `-00`.
#
# SE BORRA cuando el backend exponga los dos endpoints.
VITE_WASTE_VALIDATION_MOCK=true
